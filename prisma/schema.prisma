generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id String @id @default(uuid())

  // API identifiers
  externalId Int @unique

  name String
  type String?

  // API attributes JSON
  attributes Json
  markets    Json?

  tcgId String
  setId String

  tcg Tcg @relation(fields: [tcgId], references: [id])
  set Set @relation(fields: [setId], references: [id])

  image CardImage?

  chaseItems ChaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tcg {
  id String @id @default(uuid())

  externalId  String  @unique
  name        String
  description String?

  cards Card[]
  sets  Set[]

  createdAt DateTime @default(now())
}

model Set {
  id String @id @default(uuid())

  externalId  String    @unique
  name        String
  code        String?
  slug        String?
  releaseDate DateTime?

  tcgId String
  tcg   Tcg    @relation(fields: [tcgId], references: [id])

  cards Card[]

  createdAt DateTime @default(now())
}

model CardImage {
  id String @id @default(uuid())

  small  String?
  medium String?
  large  String?

  cardId String @unique
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model User {
  id          String   @id @default(uuid())
  clerkId     String   @unique
  email       String   @unique
  username    String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  chaseItems ChaseItem[]
  offers     Offer[]
}

model ChaseItem {
  id String @id @default(uuid())

  userId String
  cardId String

  status String @default("OPEN")

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  offers Offer[]

  createdAt DateTime @default(now())
}

model Offer {
  id String @id @default(uuid())

  sellerId    String
  chaseItemId String

  price     Float
  condition String
  message   String?

  seller    User      @relation(fields: [sellerId], references: [id])
  chaseItem ChaseItem @relation(fields: [chaseItemId], references: [id], onDelete: Cascade)

  status String @default("PENDING")

  createdAt DateTime @default(now())
}

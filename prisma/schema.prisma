generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id String @id @default(uuid())

  externalId Int @unique

  name String
  type String?

  attributes Json
  markets    Json?

  tcgId String
  setId String

  tcg Tcg @relation(fields: [tcgId], references: [id])
  set Set @relation(fields: [setId], references: [id])

  image CardImage?

  wishlistItems   WishlistItem[]
  collectionItems CollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tcg {
  id String @id @default(uuid())

  externalId  String  @unique
  name        String
  description String?

  cards Card[]
  sets  Set[]

  createdAt DateTime @default(now())
}

model Set {
  id String @id @default(uuid())

  externalId  String    @unique
  name        String
  code        String?
  slug        String?
  releaseDate DateTime?

  tcgId String
  tcg   Tcg    @relation(fields: [tcgId], references: [id])

  cards Card[]

  createdAt DateTime @default(now())
}

model CardImage {
  id String @id @default(uuid())

  small  String?
  medium String?
  large  String?

  cardId String @unique
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model User {
  id String @id @default(uuid())

  clerkId     String  @unique
  email       String  @unique
  username    String  @unique
  displayName String?

  wishlistItems   WishlistItem[]
  collectionItems CollectionItem[]

  offers Offer[]

  createdAt DateTime @default(now())
}

model CollectionItem {
  id String @id @default(uuid())

  userId String
  cardId String

  quantity Int     @default(1)
  locked   Boolean @default(false)

  condition String @default("Unknown")

  purchasePrice Decimal?
  purchaseDate  DateTime?

  notes String?

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId, condition])
}

model WishlistItem {
  id String @id @default(uuid())

  userId String
  cardId String

  user User @relation(fields: [userId], references: [id])
  card Card @relation(fields: [cardId], references: [id])

  chaseRequest ChaseRequest?

  createdAt DateTime @default(now())
  status    String   @default("ACTIVE")

  @@unique([userId, cardId])
}

model ChaseRequest {
  id String @id @default(uuid())

  status String @default("OPEN")

  wishlistItemId String @unique

  wishlistItem WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)

  offers Offer[]

  price Decimal?

  useRange Boolean @default(false)

  minPrice Decimal?
  maxPrice Decimal?

  conditions String[]

  quantity Int

  createdAt DateTime @default(now())

  @@index([conditions])
}

model Offer {
  id String @id @default(uuid())

  sellerId       String
  chaseRequestId String

  quantity Int @default(1)

  price     Decimal
  condition String
  message   String?

  seller User @relation(fields: [sellerId], references: [id])

  chaseRequest ChaseRequest @relation(fields: [chaseRequestId], references: [id], onDelete: Cascade)

  status String @default("PENDING")

  createdAt DateTime @default(now())

  @@unique([sellerId, chaseRequestId])
  @@index([status])
  @@index([chaseRequestId])
}
